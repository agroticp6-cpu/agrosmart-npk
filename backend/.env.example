# --- Serveur ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://ton-frontend.onrender.com

# --- MongoDB Atlas ---
# Récupérer cette URI depuis Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agrosmart?retryWrites=true&w=majority

# --- Authentification ---
JWT_SECRET=change_moi_avec_une_longue_chaine_aleatoire
JWT_EXPIRES_IN=7d
# Cle simple utilisee par le Raspberry Pi / ESP32 pour authentifier les envois
# de mesures et d'images (a mettre dans l'en-tete x-device-key des requetes)
DEVICE_API_KEY=change_moi_cle_appareil_iot

# --- Compte admin créé au premier démarrage (npm run seed) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_moi
ADMIN_EMAIL=admin@example.com

# --- Telegram Bot ---
# Créer le bot via @BotFather sur Telegram, copier le token ici
TELEGRAM_BOT_TOKEN=123456789:AAExempleDeTokenTelegram
# Optionnel : chat ID par defaut utilise si un utilisateur n'a pas encore
# renseigne le sien dans Parametres. Chaque utilisateur peut desormais
# relier SON PROPRE compte Telegram depuis la page Parametres du site.
TELEGRAM_CHAT_ID=123456789
# Mettre à "false" pour désactiver l'envoi réel pendant les tests
TELEGRAM_ENABLED=true

# --- Cloudinary (stockage des images caméra Raspberry Pi) ---
CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ta_cle_api
CLOUDINARY_API_SECRET=ton_secret_api

# --- Logique métier ---
# Intervalle minimum (minutes) entre deux alertes identiques pour une même zone
ALERT_COOLDOWN_MINUTES=60
# Nombre d'heures qu'une zone peut rester "rouge" avant un rappel d'alerte
CRITICAL_REMINDER_HOURS=24
# Seuils de couleur par défaut (pourcentage du besoin NPK couvert), redéfinissables par culture
THRESHOLD_VERT=80
THRESHOLD_JAUNE=50

# URL complete de l'endpoint mesures du backend deploye sur Render
BACKEND_URL=https://agrosmart-backend.onrender.com/api/mesures

# Meme cle que DEVICE_API_KEY configuree sur le backend Render
DEVICE_API_KEY=colle_ici_la_meme_cle_que_sur_render

# Port serie sur lequel le module LoRa recepteur est branche au Raspberry Pi
# (verifier avec `ls /dev/tty*` apres branchement du module)
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=115200
